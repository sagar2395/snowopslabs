{
  "vars": {
    "AvailabilitySLO": "0.99",
    "DomainSuffix": "snowops.localhost",
    "IngressClass": "traefik",
    "IngressURLSuffix": "snowops.localhost",
    "LokiRetentionPeriod": "168h",
    "MonitoringNamespace": "monitoring",
    "SinceActivation": "3m",
    "WorkloadMetric": "http_server_request_duration_seconds",
    "WorkloadName": "go-api",
    "WorkloadNamespace": "go-api",
    "WorkloadPort": "8080",
    "WorkloadService": "go-api.go-api.svc.cluster.local"
  },
  "prometheusURL": "http://prometheus.snowops.localhost",
  "kubectl": {
    "get deployment/go-api --namespace go-api -o jsonpath={.status.readyReplicas}": {
      "out": "3"
    },
    "get pdb/go-api-upgrade-pdb --namespace go-api -o jsonpath={.status.currentHealthy}": {
      "out": "3"
    },
    "get pdb/go-api-upgrade-pdb --namespace go-api -o name": {
      "out": "poddisruptionbudget.policy/go-api-upgrade-pdb\n"
    }
  },
  "http": {
    "prometheus/api/v1/query?query=sum%28rate%28http_server_request_duration_seconds_count%7Bapp%3D%22go-api%22%7D%5B10m%5D%29%29": {
      "status": 200,
      "body": "{\"status\":\"success\",\"data\":{\"resultType\":\"vector\",\"result\":[{\"metric\":{},\"value\":[1792224534.287,\"0.6408355555555556\"]}]}}"
    }
  },
  "results": {
    "pdb-present": true,
    "pdb-protects-workload": true,
    "traffic-is-flowing": true,
    "workload-highly-available": true
  }
}
