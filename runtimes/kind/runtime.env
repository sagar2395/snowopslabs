# kind runtime-specific defaults (task 064).
# Loaded by labctl and platform scripts to resolve runtime-specific values.
#
# kind (Kubernetes IN Docker) is a headless, CI-friendly local runtime. It
# mirrors what k3d exposes (host ports 80/443 via the control-plane node's
# extraPortMappings) so platform scripts don't care which local runtime is
# underneath. DOMAIN_SUFFIX stays env-driven.

INGRESS_CLASS=nginx
STORAGE_CLASS=standard
DOMAIN_SUFFIX=kind.local
REGISTRY_TYPE=kind-load
