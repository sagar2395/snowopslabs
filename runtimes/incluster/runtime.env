# In-cluster runtime profile (team mode).
#
# Used when the labctl server runs as a pod inside the cluster it manages
# (deployed via the SnowOps Labs server Helm chart). kubectl and helm auto-detect the
# in-cluster config from the mounted ServiceAccount token, so there is no
# separate cluster to create or destroy — up.sh/down.sh are no-ops.
#
# Override these per-environment via the chart's values (env:) if your cluster
# uses a different ingress class or storage class.

INGRESS_CLASS=traefik
STORAGE_CLASS=standard
DOMAIN_SUFFIX=cluster.local
REGISTRY_TYPE=none
