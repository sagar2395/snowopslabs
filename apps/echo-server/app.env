# Application-specific configuration for echo-server
# Sourced by engine/build.sh and engine/deploy.sh to discover strategies.

# === Identity (Required) ===
APP_NAME=echo-server                # Must match parent directory name

# === Build Strategy (Required) ===
BUILD_STRATEGY=docker               # docker, golang, binary, lambda-zip, etc.

# === Deploy Strategy (Required) ===
DEPLOY_STRATEGY=helm                # helm, kustomize, lambda, vm, etc.

# === Helm Deployment Settings (Required for helm strategy) ===
HELM_RELEASE_NAME=echo-server       # Release name in cluster
HELM_VALUES=values-dev.yaml         # Values file: values-dev.yaml, values-prod-like.yaml, etc.
# NAMESPACE=echo-server             # K8s namespace (defaults to APP_NAME if unset)

# === Docker Build Settings (Optional) ===
# DOCKERFILE=Dockerfile             # Dockerfile path (defaults to apps/echo-server/Dockerfile)
# DOCKER_REGISTRY=myregistry        # Registry for push (if deploying to cloud)
# DOCKER_IMAGE_TAG=latest           # Image tag (defaults to 'latest')
