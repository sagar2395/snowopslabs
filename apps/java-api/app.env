# Application-specific configuration for java-api.
# Sourced by engine/build.sh and engine/deploy.sh to discover strategies.

# === Identity (Required) ===
APP_NAME=java-api

# === Build Strategy (Required) ===
BUILD_STRATEGY=docker

# === Deploy Strategy (Required) ===
DEPLOY_STRATEGY=helm
HELM_RELEASE_NAME=java-api
# No deploy/helm of its own — the shared workload chart deploys it from the
# contract below, which is the same path a user's own application takes.

# === Workload contract (ADR-0014) ===
APP_PORT=8080
APP_REQUEST_METRIC=http_server_request_duration_seconds
APP_CAPABILITIES=prometheus-metrics,readiness-toggle

# A JVM needs a far larger memory floor than the Go services: ~40Mi resident at
# rest against their ~7Mi. Sizing it like them is what makes a scenario grade the
# language instead of the engineer — see ADR-0014.
MEMORY_REQUEST=192Mi
MEMORY_LIMIT=384Mi
CPU_REQUEST=100m
CPU_LIMIT=1000m
