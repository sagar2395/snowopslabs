# Tool Versions Configuration.
#
# These are MINIMUM versions, not exact pins. bootstrap/setup-tools.sh treats
# an existing tool at or above the minimum as satisfying the requirement, and
# only downloads a newer one when needed. This matches how `labctl doctor`
# checks the environment. If a maintainer wants a specific tested version, they
# can update the minimum here and CI will exercise it.
#
# The version numbers below are the newest known-good releases at the time
# they were last touched — bumping one only requires it, never forbids newer.
#
# Last updated: 2026-07-26

# Kubernetes
# kubectl releases: https://github.com/kubernetes/kubernetes/releases
KUBECTL_VERSION=1.36.1

# k3d (Kubernetes in Docker)
# k3d releases: https://github.com/k3d-io/k3d/releases
K3D_VERSION=5.8.3

# kind (headless local cluster; powers CI and the nightly e2e job)
# kind releases: https://github.com/kubernetes-sigs/kind/releases
KIND_VERSION=0.27.0

# Docker
# docker releases: https://docs.docker.com/engine/release-notes/
DOCKER_VERSION=29.2.1

# Helm — 3.12+ is the minimum; helm 4 is accepted.
# helm releases: https://github.com/helm/helm/releases
HELM_VERSION=3.12.0

# ArgoCD CLI (for CD pipeline GitOps sync)
# argocd releases: https://github.com/argoproj/argo-cd/releases
ARGOCD_VERSION=2.10.0

# --- Platform: Service Mesh (platform/mesh/, task 054) ---
# These pin the Helm chart versions for the swappable mesh providers.
# Override per-install via the matching env var if you need a different release.

# Istio (istio/base + istio/istiod charts share the app version)
# istio releases: https://github.com/istio/istio/releases
ISTIO_VERSION=1.24.2

# Linkerd stable Helm charts (helm.linkerd.io/stable)
# linkerd-crds chart releases: https://github.com/linkerd/linkerd2/releases
LINKERD_CRDS_CHART_VERSION=1.8.0
# linkerd-control-plane chart releases: https://github.com/linkerd/linkerd2/releases
LINKERD_CONTROL_PLANE_CHART_VERSION=1.16.11

# --- Platform: Data Infrastructure (platform/data/, task 055) ---
# Pinned chart/app versions for the additive data sub-components (kafka, postgres).
# Override per-install via the matching env var if you need a different release.

# Kafka via Strimzi operator (KRaft mode)
# strimzi-kafka-operator chart releases: https://github.com/strimzi/strimzi-kafka-operator/releases
STRIMZI_VERSION=0.45.0
# Kafka broker version the operator runs (must be supported by STRIMZI_VERSION)
KAFKA_VERSION=3.9.0

# Postgres via CloudNativePG operator
# cloudnative-pg chart releases: https://github.com/cloudnative-pg/charts/releases
CNPG_CHART_VERSION=0.23.0

# --- Platform: Secrets Management (platform/secrets/, task 056) ---
# Pinned chart versions for the secrets backend (vault) + sync operator (ESO).
# Override per-install via the matching env var if you need a different release.

# HashiCorp Vault (dev mode for the lab)
# hashicorp/vault chart releases: https://github.com/hashicorp/vault-helm/releases
VAULT_CHART_VERSION=0.28.1

# External Secrets Operator
# external-secrets chart releases: https://github.com/external-secrets/external-secrets/releases
ESO_CHART_VERSION=0.10.5

# --- Platform: Autoscaling (platform/autoscaling/, task 057) ---
# Pinned chart version for the KEDA event/metric-driven autoscaler.
# Override per-install via the matching env var if you need a different release.

# KEDA (chart version tracks the app version)
# kedacore/keda chart releases: https://github.com/kedacore/charts/releases
KEDA_CHART_VERSION=2.15.1

# --- Platform: Cost Visibility (platform/cost/, task 061) ---
# Pinned chart version for the OpenCost per-namespace cost estimator.
# Override per-install via OPENCOST_CHART_VERSION if you need a different release.

# OpenCost
# opencost/opencost chart releases: https://github.com/opencost/opencost-helm-chart/releases
OPENCOST_CHART_VERSION=1.43.2
