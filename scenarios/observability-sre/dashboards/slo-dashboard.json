{
 "annotations": {
  "list": []
 },
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 1,
 "links": [],
 "panels": [
  {
   "title": "Request Rate (req/s)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate({{.WorkloadMetric}}_count{app=\"$app\"}[5m]))",
     "legendFormat": "Total"
    },
    {
     "expr": "sum(rate({{.WorkloadMetric}}_count{app=\"$app\",http_response_status_code=~\"5..\"}[5m]))",
     "legendFormat": "5xx Errors"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "unit": "reqps"
    }
   }
  },
  {
   "title": "Availability, last hour (SLO 99.9%)",
   "type": "gauge",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "1 - (sum(rate({{.WorkloadMetric}}_count{app=\"$app\",http_response_status_code=~\"5..\"}[1h])) / sum(rate({{.WorkloadMetric}}_count{app=\"$app\"}[1h])))",
     "legendFormat": "Availability"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0.99,
     "max": 1,
     "thresholds": {
      "steps": [
       {
        "value": 0,
        "color": "red"
       },
       {
        "value": 0.999,
        "color": "yellow"
       },
       {
        "value": 0.9999,
        "color": "green"
       }
      ]
     }
    }
   }
  },
  {
   "title": "Error Budget Remaining (30d window)",
   "type": "stat",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "1 - ((sum(increase({{.WorkloadMetric}}_count{app=\"$app\",http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase({{.WorkloadMetric}}_count{app=\"$app\"}[30d])), 1)) / (1 - 0.999))",
     "legendFormat": "Budget"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0
       },
       {
        "color": "green",
        "value": 0.25
       }
      ]
     }
    }
   },
   "description": "The share of the 30-day error budget (0.1% of requests may fail) not yet spent. 100% means no 5xx so far; 0% or below means the SLO is breached. Prometheus only keeps a few days here, so the window is really its retention.",
   "options": {
    "colorMode": "background"
   }
  },
  {
   "title": "Latency (p50 / p95 / p99)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum(rate({{.WorkloadMetric}}_bucket{app=\"$app\"}[5m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate({{.WorkloadMetric}}_bucket{app=\"$app\"}[5m])) by (le))",
     "legendFormat": "p95"
    },
    {
     "expr": "histogram_quantile(0.99, sum(rate({{.WorkloadMetric}}_bucket{app=\"$app\"}[5m])) by (le))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "unit": "s"
    }
   }
  },
  {
   "title": "Active Alerts",
   "type": "table",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "count(ALERTS{scenario=\"observability-sre\", alertstate=\"firing\"}) or vector(0)",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity",
       "alertstate": "State"
      }
     }
    }
   ],
   "description": "Zero until an alert fires. Break readiness under load to drive PodNotReady from inactive to firing."
  },
  {
   "title": "Pod Memory Usage",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"}",
     "legendFormat": "{{pod}} / {{container}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 20
     },
     "unit": "bytes"
    }
   }
  },
  {
   "title": "Pod CPU Usage",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[5m])",
     "legendFormat": "{{pod}} / {{container}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 20
     },
     "unit": "short"
    }
   }
  }
 ],
 "schemaVersion": 39,
 "tags": [
  "slo",
  "sre",
  "scenario"
 ],
 "templating": {
  "list": [
   {
    "name": "app",
    "label": "App",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "description": "The workload these panels show. Defaults to the app this scenario was activated for.",
    "query": {
     "query": "query_result(count by (app) ({{.WorkloadMetric}}_count) or label_replace(vector(1), \"app\", \"{{.WorkloadName}}\", \"\", \"\"))",
     "refId": "app",
     "qryType": 3
    },
    "definition": "query_result(count by (app) ({{.WorkloadMetric}}_count) or label_replace(vector(1), \"app\", \"{{.WorkloadName}}\", \"\", \"\"))",
    "regex": "/app=\"([^\"]+)\"/",
    "refresh": 1,
    "includeAll": false,
    "multi": false,
    "sort": 1,
    "current": {
     "selected": true,
     "text": "{{.WorkloadName}}",
     "value": "{{.WorkloadName}}"
    },
    "options": []
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "description": "Where the selected app runs.",
    "query": {
     "query": "label_values(kube_deployment_spec_replicas{deployment=\"$app\"}, namespace)",
     "refId": "namespace",
     "qryType": 1
    },
    "definition": "label_values(kube_deployment_spec_replicas{deployment=\"$app\"}, namespace)",
    "refresh": 1,
    "includeAll": false,
    "multi": false,
    "sort": 0,
    "current": {
     "selected": true,
     "text": "{{.WorkloadNamespace}}",
     "value": "{{.WorkloadNamespace}}"
    },
    "options": []
   }
  ]
 },
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timepicker": {},
 "timezone": "browser",
 "title": "SLO Dashboard",
 "uid": "scenario-slo-workload"
}
