{
  "vars": {
    "DomainSuffix": "snowops.localhost",
    "IngressClass": "traefik",
    "IngressURLSuffix": "snowops.localhost",
    "LokiRetentionPeriod": "168h",
    "MonitoringNamespace": "monitoring",
    "SinceActivation": "1m",
    "WorkloadMetric": "http_server_request_duration_seconds",
    "WorkloadName": "go-api",
    "WorkloadNamespace": "go-api",
    "WorkloadPort": "8080",
    "WorkloadService": "go-api.go-api.svc.cluster.local"
  },
  "prometheusURL": "http://prometheus.snowops.localhost",
  "kubectl": {
    "get certificate/go-api-tls --namespace go-api -o jsonpath={.status.conditions[?(@.type=='Ready')].status}": {
      "out": "",
      "err": "kubectl: exit status 1: Error from server (NotFound): certificates.cert-manager.io \"go-api-tls\" not found"
    },
    "get certificate/lab-ca --namespace cert-manager -o jsonpath={.status.conditions[?(@.type=='Ready')].status}": {
      "out": "True"
    },
    "get deployment/cert-manager --namespace cert-manager -o jsonpath={.status.readyReplicas}": {
      "out": "1"
    },
    "get deployment/kyverno-admission-controller --namespace kyverno -o jsonpath={.status.readyReplicas}": {
      "out": "1"
    }
  },
  "http": {
    "prometheus/api/v1/query?query=count%28kyverno_policy_results_total%29": {
      "status": 200,
      "body": "{\"status\":\"success\",\"data\":{\"resultType\":\"vector\",\"result\":[]}}"
    },
    "prometheus/api/v1/query?query=min%28up%7Bkubernetes_namespace%3D%22go-api%22%2Cjob%3D%22go-api%22%7D%29": {
      "status": 200,
      "body": "{\"status\":\"success\",\"data\":{\"resultType\":\"vector\",\"result\":[{\"metric\":{},\"value\":[1792224580.075,\"1\"]}]}}"
    }
  },
  "results": {
    "cert-manager-ready": true,
    "kyverno-metrics-scraped": false,
    "kyverno-ready": true,
    "lab-ca-issued": true,
    "workload-scrape-not-blocked": true,
    "workload-tls-certificate-ready": false
  }
}
