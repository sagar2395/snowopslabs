 },
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 2,
 "id": null,
 "links": [],
 "panels": [
  {
   "title": "Active Chaos Experiments",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(chaos_controller_manager_chaos_experiments{phase=\"running\"}) or vector(0)",
     "legendFormat": "Running"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "red",
        "value": 3
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   }
  },
  {
   "title": "Experiments defined",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 5,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(chaos_controller_manager_chaos_experiments) or vector(0)",
     "legendFormat": "Total"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   }
  },
  {
   "title": "Pods restarted or replaced (last 15m)",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 10,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "(sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[15m])) or vector(0)) + (count(time() - kube_pod_created{namespace=\"$namespace\"} < 900) or vector(0))",
     "legendFormat": "pods"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   },
   "description": "A container restart (an OOMKill, a failed probe) and a pod created in the last 15 minutes (a pod-kill replaces the pod rather than restarting it) both count."
  },
  {
   "title": "Unavailable Replicas",
   "type": "stat",
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 15,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=\"$namespace\"}) or vector(0)",
     "legendFormat": "Unavailable"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   }
  },
  {
   "title": "PDB Disruptions Allowed ($app)",
   "type": "stat",
   "description": "How many $app pods the PodDisruptionBudget will let a drain evict. 0 means a node drain blocks forever \u2014 scale the Deployment out until this is at least 1.",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(kube_poddisruptionbudget_status_pod_disruptions_allowed{namespace=\"$namespace\"}) or vector(0)",
     "legendFormat": "allowed"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    }
   }
  },
  {
   "title": "HTTP Request Rate ($app)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate({{.WorkloadMetric}}_count{app=\"$app\"}[1m])) by (http_response_status_code)",
     "legendFormat": "{{http_response_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "pointSize": 5,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "reqps"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^2.."
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "green",
         "mode": "fixed"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^5.."
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "red",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "title": "HTTP request latency: p50 / p95 / p99 ($app)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate({{.WorkloadMetric}}_bucket{app=\"$app\"}[5m])))",
     "legendFormat": "p99"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate({{.WorkloadMetric}}_bucket{app=\"$app\"}[5m])))",
     "legendFormat": "p95"
    },
    {
     "expr": "histogram_quantile(0.50, sum by (le) (rate({{.WorkloadMetric}}_bucket{app=\"$app\"}[5m])))",
     "legendFormat": "p50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    }
   },
   "description": "$app's own handler timings. This is SERVER-side latency: it is blind to network faults, so a NetworkChaos delay leaves it flat. Measure those client-side with curl's time_starttransfer through the ingress."
  },
  {
   "title": "Pod Restart Timeline",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1m])",
     "legendFormat": "{{namespace}}/{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    }
   }
  },
  {
   "title": "Ready vs Desired Replicas",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "kube_deployment_status_replicas_ready{namespace=\"$namespace\"}",
     "legendFormat": "{{deployment}} ready"
    },
    {
     "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\"}",
     "legendFormat": "{{deployment}} desired"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*desired"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "title": "CPU Usage During Chaos",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[5m])) by (namespace, pod)",
     "legendFormat": "{{namespace}}/{{pod}}"
    },
    {
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"cpu\"}) by (namespace, pod)",
     "legendFormat": "{{namespace}}/{{pod}} limit"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15
     },
     "unit": "short"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*limit"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "fixedColor": "red",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "title": "Memory Usage During Chaos",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\"}) by (namespace, pod)",
     "legendFormat": "{{namespace}}/{{pod}}"
    },
    {
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\"}) by (namespace, pod)",
     "legendFormat": "{{namespace}}/{{pod}} limit"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15
     },
     "unit": "bytes"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*limit"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "fixedColor": "red",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "title": "OOMKill Events",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 28
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "increase(kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", reason=\"OOMKilled\"}[5m])",
     "legendFormat": "{{namespace}}/{{pod}} ({{container}})"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 80,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "fixedColor": "red",
      "mode": "fixed"
     }
    }
   }
  },
  {
   "title": "Seen from the client \u2014 where the app's own metrics cannot look",
   "type": "text",
   "gridPos": {
    "h": 4,
    "w": 24,
    "x": 0,
    "y": 36
   },
   "options": {
    "mode": "markdown",
    "content": "Everything above is measured **inside** $app: its own histogram, its own restarts. That view has a blind spot, and two of this scenario's failure modes live in it.\n\nA killed pod records nothing \u2014 it is not there to record. A 300ms network delay never touches handler time, so the p99 above stays flat while every caller waits. A partition leaves the pod `1/1 Ready` with perfect metrics while nothing can reach it.\n\nThe panels below are the **load generator's** view: failures and latency as a client experiences them. Start traffic with `labctl traffic start --profile browse --rps 20 --duration 30m` or they are empty, honestly."
   }
  },
  {
   "title": "Client-observed failure rate \u2014 the blast radius",
   "type": "timeseries",
   "description": "The share of requests k6 sent in the last minute that failed. A pod-kill against one replica shows as a short spike; a working PodDisruptionBudget and enough replicas keep it near zero.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "((sum (rate(k6_http_reqs_total{url=~\"https?://$app\\\\..*\",expected_response=\"false\"}[1m])) or 0 * sum (rate(k6_http_reqs_total{url=~\"https?://$app\\\\..*\"}[1m]))) / sum (rate(k6_http_reqs_total{url=~\"https?://$app\\\\..*\"}[1m]))) or vector(0)",
     "legendFormat": "failed fraction",
     "refId": "A"
    }
   ]
  },
  {
   "title": "Client-observed latency (k6)",
   "type": "timeseries",
   "description": "k6 calls the Service inside the cluster, so it does not cross the ingress where network-delay and network-partition act. Measure those with the curl command on the Explore tab, which goes through the ingress.",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": false,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(k6_http_req_duration_p99{url=~\"https?://$app\\\\..*\"}) or vector(0)",
     "legendFormat": "p99",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(k6_http_req_duration_p95{url=~\"https?://$app\\\\..*\"}) or vector(0)",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(k6_http_req_duration_p50{url=~\"https?://$app\\\\..*\"}) or vector(0)",
     "legendFormat": "p50",
     "refId": "C"
    }
   ]
  }
 ],
 "schemaVersion": 39,
 "tags": [
  "chaos",
  "reliability",
