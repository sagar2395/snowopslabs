{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "ExternalSecret sync calls (go-api-secret)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every successful refresh ESO makes against Vault. A rotation lands on the next non-zero step of the successful series.",
      "targets": [
        {
          "expr": "sum by (status) (rate(externalsecret_sync_calls_total{name=\"go-api-secret\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "title": "ExternalSecret Ready (go-api-secret)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 while the Secret is in sync with Vault. It dips if the Vault token is wrong, Vault is down, or the key is missing.",
      "targets": [
        {
          "expr": "max(externalsecret_status_condition{name=\"go-api-secret\",condition=\"Ready\",status=\"True\"})",
          "legendFormat": "Ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "min": 0,
          "max": 1,
          "unit": "short"
        }
      }
    },
    {
      "title": "Vault API calls made by ESO",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Provider-side traffic. This is the cost of a short refreshInterval \u2014 every ExternalSecret polls Vault on its own cycle.",
      "targets": [
        {
          "expr": "sum by (status) (rate(externalsecret_provider_api_calls_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "title": "ExternalSecret reconcile duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How long the last refresh took end to end. Part of the delay between rotating in Vault and the value appearing in the pod.",
      "targets": [
        {
          "expr": "max(externalsecret_reconcile_duration{name=\"go-api-secret\"})",
          "legendFormat": "go-api-secret"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ns"
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "secrets",
    "external-secrets",
    "vault",
    "rotation"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "title": "Secret Rotation",
  "uid": "secret-rotation"
}
