{
    "annotations": {
        "list": []
    },
    "editable": true,
    "graphTooltip": 1,
    "links": [],
    "title": "GitOps Delivery — ArgoCD",
    "uid": "gitops-delivery",
    "tags": [
        "gitops",
        "argocd",
        "delivery"
    ],
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 39,
    "panels": [
        {
            "title": "Applications by sync status",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (sync_status) (argocd_app_info)",
                    "legendFormat": "{{sync_status}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 15
                    }
                },
                "overrides": []
            }
        },
        {
            "title": "Applications by health status",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (health_status) (argocd_app_info)",
                    "legendFormat": "{{health_status}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 15
                    }
                },
                "overrides": []
            }
        },
        {
            "title": "Sync operations in the last 10 minutes, by outcome",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (phase) (increase(argocd_app_sync_total[10m]))",
                    "legendFormat": "{{phase}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            },
            "description": "Syncs are rare, so a per-second rate always reads zero. A self-heal or a push you made shows as a step here."
        },
        {
            "title": "Reconciliation time (p95)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(argocd_app_reconcile_bucket[5m])))",
                    "legendFormat": "p95"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            }
        },
        {
            "title": "Git requests to the source repo",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 16
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "expr": "sum by (request_type) (rate(argocd_git_request_total[5m]))",
                    "legendFormat": "{{request_type}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                },
                "overrides": []
            }
        }
    ]
}
