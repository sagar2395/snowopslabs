# Keep the labctl-server image lean and reproducible: exclude VCS, build
# artifacts, local runtime state, and frontend build inputs the binary doesn't
# need at runtime (the binary embeds cmd/labctl/ui/dist, copied during build).
.git
.github
bin/
dist/
**/.labctl/
*.test
coverage.out
coverage.html
ui/node_modules/
ui/dist/
**/*.log
.DS_Store
