      },
      "targets": [
        {
          "expr": "sum by (app, http_response_status_code) (rate(http_server_request_duration_seconds_count{app=~\"$app\"}[1m]))",
          "legendFormat": "{{app}} {{http_response_status_code}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "Filtered on the app label. The scrape job for annotation-discovered pods is 'kubernetes-pods', not the app name, so filtering on job here would always be empty."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(http_server_request_duration_seconds_count{app=~\"$app\", http_response_status_code=~\"5..\"}[5m])) or 0 * sum by (app) (rate(http_server_request_duration_seconds_count{app=~\"$app\"}[5m]))",
          "legendFormat": "5xx {{app}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "5xx responses per second. A line at 0 means the app is serving and failing nothing; no line means it is not serving at all."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Offered vs served: k6 sent vs app handled",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{url=~\"https?://$app\\\\..*\"}[1m]))",
          "legendFormat": "k6 sent (client)",
          "refId": "A",
          "format": "time_series"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{app=~\"$app\"}[1m]))",
          "legendFormat": "handled by the app (server)",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "description": "Two lines that should overlap when only k6 is loading the selected apps. k6 counts what it sent to them; the apps count what they handled, which also includes kubelet probes and any traffic that did not come from k6. A persistent gap beyond that means requests are lost before reaching the app."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "k6 client-observed latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
