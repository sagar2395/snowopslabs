  },
  "description": "Server-side application request metrics alongside the k6 load generator's client-side view.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Server-side** panels (`http_requests_total`) count what the app actually handled. **Client-side** panels (`k6_*`) count what the load generator sent. A gap between them is the interesting signal: requests dropped at the ingress, rejected by a full queue, or lost to pod restarts never reach the app's counters.\n\nGenerate load with `labctl traffic start --profile steady --rps 25`, then compare the two rows. The `k6_*` series only appear while a run is in flight."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by app (server-side)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(http_requests_total[1m]))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "Every route is metered by one middleware, so this moves for any traffic the app serves."
    },
