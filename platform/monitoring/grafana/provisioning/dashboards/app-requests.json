        ]
      },
      "targets": [
        {
          "expr": "sum by (app, status) (label_replace(label_replace(rate(k6_http_reqs_total{url=~\"https?://$app\\\\..*\"}[1m]), \"app\", \"$1\", \"url\", \"https?://([^.]+)\\\\..*\"), \"status\", \"no response\", \"status\", \"0\"))",
          "legendFormat": "{{app}} {{status}}",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "description": "What k6 got back for each request it sent, by HTTP status. 'no response' is a request that got no answer at all (connection refused or timed out): the failures the app's own counters can never see."
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "application",
    "http",
    "metrics",
    "traffic"
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, app)",
          "refId": "app"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Application Request Metrics",
  "uid": "app-requests",
  "version": 0
}
