          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "label_replace(label_replace(max by (url) (k6_http_req_duration_p95{url=~\"https?://$app\\\\..*\"}), \"app\", \"$1\", \"url\", \"https?://([^.]+)\\\\..*\"), \"route\", \"$1\", \"url\", \"https?://[^/]+(/.*)\")",
          "legendFormat": "p95 {{app}} {{route}}",
          "refId": "A",
          "format": "time_series"
        },
        {
          "expr": "label_replace(label_replace(max by (url) (k6_http_req_duration_p99{url=~\"https?://$app\\\\..*\"}), \"app\", \"$1\", \"url\", \"https?://([^.]+)\\\\..*\"), \"route\", \"$1\", \"url\", \"https?://[^/]+(/.*)\")",
          "legendFormat": "p99 {{app}} {{route}}",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "description": "Latency as the k6 client measured it, per route it hit. The k6 panels follow the App selector through the URL each request was sent to."
    },
